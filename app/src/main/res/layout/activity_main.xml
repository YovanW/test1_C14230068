<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context="MainActivity">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
           android:gravity="center"
            android:text="="
            android:textColor="#121212"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Campus Activity"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            >
        </TextView>

        <!-- penyeimbang agar judul tetap di tengah -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- gbr kampus -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="211dp"
            android:src="@drawable/campus">

        </ImageView>

    </LinearLayout>


    <!-- Daftar Kegiatan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Daftar Kegiatan"
            android:textColor="#121212"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/itemKegiatanSeminar"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="77dp"
                android:padding="8dp"
                android:src="@drawable/people_mic" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seminar Teknologi 2026"
                    android:textColor="#121212"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textSeminar6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membangun Aplikasi Android Modern"
                    android:textColor="#121212"
                    android:textSize="10sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/calendar_icon_free_vector">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  20 Oktober 2026"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/clock">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  09.00 - 12.00 WIB"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/location">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Auditorium Kampus XYZ"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemPhone"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="77dp"
                android:padding="8dp"
                android:src="@drawable/laptop_table" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workshop UI/UX Design"
                    android:textColor="#121212"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textWorkshop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dari Ide Menjadi Desain yang Menarik"
                    android:textColor="#121212"
                    android:textSize="10sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/calendar_icon_free_vector">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  25 Oktober 2026"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/clock">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  13.00 - 16.00 WIB"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/location">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Lab Komputer Lt. 3"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="77dp"
                android:padding="8dp"
                android:src="@drawable/campus_fair" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus Fair 2026"
                    android:textColor="#121212"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textCampusFair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temukan Peluang untuk Masa Depanmu"
                    android:textColor="#121212"
                    android:textSize="10sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/calendar_icon_free_vector">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  28 Oktober 2026"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/clock">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  08.00 - 15.00 WIB"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/location">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Lapangan Kampus XYZ"
                        android:textSize="11sp"
                        android:gravity="center_vertical"
                        >
                    </TextView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">


        <LinearLayout
            android:layout_width="175dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card"
            android:id="@+id/about"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="57dp"
                android:layout_height="53dp"
                android:src="@drawable/info">

            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginTop="15dp"
                android:text="Tentang Aplikasi">

            </TextView>


        </LinearLayout>



        <LinearLayout
            android:layout_width="211dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/developer"
            >

            <ImageView
                android:layout_width="70dp"
                android:layout_height="53dp"
                android:src="@drawable/email">

            </ImageView>

            <TextView
                android:layout_width="123dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginTop="15dp"
                android:text="Hubungi Developer">

            </TextView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>